{
  "name": "authalcateiahits",
  "description": "Sistema de autentica\u00e7\u00e3o da Alcat\u00e9ia Hits - Servidor OpenAuth no Cloudflare Workers.",
  "private": true,
  "cloudflare": {
    "label": "Alcat\u00e9ia Hits Auth Server",
    "products": [
      "Workers",
      "D1",
      "KV"
    ],
    "categories": [],
    "icon_urls": [
      "https://alcateiahits.org/src/img/loboalpha80px.png"
    ],
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/b2ff10c6-8f7c-419f-8757-e2ccf1c84500/public",
